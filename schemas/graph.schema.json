{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/nous/graph.schema.json",
  "title": "Nous Graph Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "nodes", "edges"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "review_status": {
      "type": "string",
      "enum": ["agent_generated", "needs_review", "reviewed", "rejected", "deprecated"]
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "review_status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "artifact",
            "memory",
            "value",
            "belief",
            "claim",
            "pattern",
            "project",
            "decision",
            "person",
            "question",
            "contradiction",
            "identity"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "review_status": { "$ref": "#/$defs/review_status" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        },
        "source_path": { "type": "string" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "relationship", "review_status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "relationship": {
          "type": "string",
          "enum": [
            "evidenced_by",
            "supports",
            "contradicts",
            "influenced_by",
            "expresses",
            "mentions",
            "changed_by",
            "part_of",
            "similar_to"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_status": { "$ref": "#/$defs/review_status" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        }
      }
    }
  }
}
